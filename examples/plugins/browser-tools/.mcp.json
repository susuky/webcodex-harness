{
  "mcpServers": {
    "browser": {
      "command": "${BROWSER_NODE}",
      "args": [
        "${BROWSER_MCP_CLI}",
        "--config", "${PLUGIN_ROOT}/browser.config.json",
        "--output-dir", "${TASK_STATE_DIR}/artifacts",
        "--allowed-origins", "${BROWSER_ALLOWED_ORIGINS}"
      ],
      "allowedTools": [
        "browser_navigate",
        "browser_navigate_back",
        "browser_snapshot",
        "browser_click",
        "browser_type",
        "browser_fill_form",
        "browser_select_option",
        "browser_press_key",
        "browser_wait_for",
        "browser_tabs",
        "browser_evaluate",
        "browser_take_screenshot",
        "browser_close"
      ]
    }
  }
}
